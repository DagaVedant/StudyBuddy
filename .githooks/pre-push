#!/bin/sh

if [ "$SKIP_MIGRATION_CHECK" = "1" ]; then
  exit 0
fi

pushing_main=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ -z "$remote_ref" ]; then
    continue
  fi

  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_ref" = "refs/heads/main" ]; then
    pushing_main=1
  fi
done

if [ "$pushing_main" -eq 0 ]; then
  exit 0
fi

if npx tsx scripts/migrate.ts --check; then
  exit 0
fi

echo ""
echo "Push refused: the database is behind the migrations on this branch."
echo "Deploying this would serve code against a schema that cannot answer it."
echo ""
echo "  npm run db:migrate     apply them, then push again"
echo "  SKIP_MIGRATION_CHECK=1 git push    push anyway"

exit 1
