# --- Database -------------------------------------------------------------
# Postgres with the pgvector extension available (Neon, Supabase, or local).
# Use the POOLED connection string on Vercel.
DATABASE_URL="postgresql://user:password@host/studybuddy?sslmode=require"

# --- Auth (spec §2) -------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Admin accounts (spec §2.1). Comma-separated, matched against the VERIFIED
# email at login. There is deliberately no UI to grant admin.
ADMIN_EMAILS="vedant@example.com,avya@example.com"

# --- Encryption (spec §3.6) -----------------------------------------------
# Master key for AES-256-GCM encryption of user-supplied API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY=""

# --- Storage --------------------------------------------------------------
# Vercel Blob, for rasterized page images (spec §4 stage 3).
BLOB_READ_WRITE_TOKEN=""

# --- Operator GPU worker (spec §3.3) --------------------------------------
# Bearer token the pull-worker uses to claim jobs and write results.
# Scoped to claim+write only. Rotate freely.
WORKER_API_TOKEN=""
# Optional: restrict the worker credential to the VPS exit node IP (spec §3.3.1).
WORKER_ALLOWED_IPS=""

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Operator GPU: the worker's own settings ------------------------------
# Read by scripts/gpu-worker.ts and the benchmark scripts, not by the app.
# Every one has a default in code; set them only to override.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_VISION_MODEL="qwen2.5vl:7b"
# Falls back to the vision model when empty.
OLLAMA_REVIEW_MODEL=""
# Works questions out, for the answer key and the topic lessons. A pure text
# model: solving needs no vision, so this is free to be whatever reasons best
# in the VRAM left over.
#
# Chosen by measurement, not reputation. Scored against 25 questions whose
# answers came from the papers' own keys (scripts/benchmark-answers.ts):
#
#   gpt-oss:20b    23/25 correct   0 confident-wrong   0 truncated   127s
#   gemma4:12b     20/25 correct   0 confident-wrong   5 truncated   906s
#   qwen3.5:9b     16/25 correct   1 confident-wrong   7 truncated   792s
#
# It wins on every axis at once, including six times faster. The truncations
# matter as much as the score: both smaller models are reasoners that spend the
# output budget thinking and emit nothing, so they fail without saying so.
OLLAMA_ANSWER_MODEL="gpt-oss:20b"
# gpu_workers.name is UNIQUE, so two machines left on the default collide and
# the second one silently takes over the first one's row.
WORKER_NAME="local-gpu"

# --- Connection pool ------------------------------------------------------
# Defaults are 5, 30 and 1800. Neon's free tier is the reason the pool is
# small; raising it past what the plan allows fails at connect time, not here.
DATABASE_POOL_MAX="5"
DATABASE_IDLE_TIMEOUT="30"
DATABASE_MAX_LIFETIME="1800"

# --- Tuning and tests: leave every one of these empty in production -------
# Each is compared against the exact string "true", so "false" and "0" read
# the same as empty. Emptying one is how you turn it off; there is no way to
# spell "off" that differs from unset.
#
# Answers extraction from a fixture instead of calling a model. The e2e suite
# sets it; nothing else should.
ENABLE_MOCK_AI=""
# Turns off the upload and page-upload limiters.
DISABLE_RATE_LIMITS=""
# Lets the app boot without running pending migrations.
SKIP_MIGRATIONS=""
# Unlocks /api/test/*, which mint an admin account and rewrite trial usage
# with no session and no credential. Also refused whenever VERCEL_ENV is set,
# so a deployment ignores it even if it is "true"; keep it empty anyway, since
# that second guard is the only thing standing between this line and a
# takeover of any host that is not Vercel.
ENABLE_TEST_ENDPOINTS=""
