# Database
DATABASE_URL="postgresql://user:password@host/studybuddy?sslmode=require"
DATABASE_POOL_MAX="5"
DATABASE_IDLE_TIMEOUT="30"
DATABASE_MAX_LIFETIME="1800"

# Auth
AUTH_SECRET=""
ADMIN_EMAILS=""
CREDENTIALS_ENC_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email
MAIL_FROM=""
MAIL_FROM_NAME="StudyBuddy"
SMTP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""

# Storage
BLOB_READ_WRITE_TOKEN=""

# Authenticates /api/cron/drain-server-queue. Vercel's daily cron sends it, and
# so does the app itself: after every job the server kicks that route to start
# a fresh invocation while work remains, which is how a queue drains between
# uploads without waiting for midnight. Unset, the queue only moves on upload
# and on the cron.
CRON_SECRET=""

# Set to "true" to show the "your own API key" form in settings, so a student
# can bring their own cloud provider. Unset, only the operator's OpenRouter key
# below does any reading.
ENABLE_CLOUD_EXTRACTION=""

# The operator's own OpenRouter key. This is what reads worksheets for the free
# trial. Unset, the trial reads nothing: uploads land as awaiting_review and
# the student adds questions by hand.
OPENROUTER_API_KEY=""

# Model the trial reads with. Defaults to DEFAULT_CLOUD_MODEL.openrouter.
OPENROUTER_MODEL=""

# Comma-separated models OpenRouter falls back to when the first is rate
# limited or gone. Free models sit on shared pools and go away without notice.
OPENROUTER_FALLBACK_MODELS=""

# How many requests a day the operator key may make before the site stops
# reading for the trial and says so. OpenRouter's free models allow about 50.
# The homepage warns at 80% of this. Raise it if you buy credits.
OPENROUTER_CALLS_PER_DAY=""

# Development only
ENABLE_MOCK_AI=""
DISABLE_RATE_LIMITS=""
SKIP_MIGRATIONS=""

# Public launch
CONTACT_EMAIL=""
TRIAL_DAILY_WORKSHEETS=""
SIGNUP_INVITE_CODE=""
ALERT_EMAIL=""
ERROR_WEBHOOK_URL=""
