# Database
DATABASE_URL="postgresql://user:password@host/studybuddy?sslmode=require"
DATABASE_POOL_MAX="5"
DATABASE_IDLE_TIMEOUT="30"
DATABASE_MAX_LIFETIME="1800"

# Auth
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAILS=""
CREDENTIALS_ENC_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email, for password reset only. Plain SMTP, so a Gmail app password works and
# there is no provider to sign up with and no domain to own. Host and port
# default to Gmail, user defaults to MAIL_FROM. Unset means no reset.
MAIL_FROM=""
MAIL_FROM_NAME="StudyBuddy"
SMTP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""

# Storage
BLOB_READ_WRITE_TOKEN=""

# GPU worker
WORKER_API_TOKEN=""
WORKER_ALLOWED_IPS="*"
WORKER_NAME="local-gpu"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_VISION_MODEL="qwen2.5vl:7b"
OLLAMA_REVIEW_MODEL=""
OLLAMA_ANSWER_MODEL="gpt-oss:20b"

# Scheduled drain
CRON_SECRET=""

# Web push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Development only. Each is compared against the exact string "true".
# ENABLE_TEST_ENDPOINTS unlocks routes that mint an admin account with no
# session; it must stay empty outside local development.
ENABLE_MOCK_AI=""
DISABLE_RATE_LIMITS=""
SKIP_MIGRATIONS=""
ENABLE_TEST_ENDPOINTS=""

# Public launch
CONTACT_EMAIL=""
TRIAL_DAILY_WORKSHEETS=""
SIGNUP_INVITE_CODE=""
ALERT_EMAIL=""
ERROR_WEBHOOK_URL=""
