# Database
DATABASE_URL="postgresql://user:password@host/studybuddy?sslmode=require"
DATABASE_POOL_MAX="5"
DATABASE_IDLE_TIMEOUT="30"
DATABASE_MAX_LIFETIME="1800"

# Auth
AUTH_SECRET=""
ADMIN_EMAILS=""
CREDENTIALS_ENC_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email
MAIL_FROM=""
MAIL_FROM_NAME="StudyBuddy"
SMTP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""

# Storage
BLOB_READ_WRITE_TOKEN=""

# GPU worker
WORKER_API_TOKEN=""
WORKER_ALLOWED_IPS="*"
WORKER_NAME="local-gpu"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_VISION_MODEL="qwen2.5vl:7b"
OLLAMA_REVIEW_MODEL=""
OLLAMA_ANSWER_MODEL="gpt-oss:20b"

# Scheduled drain
CRON_SECRET=""

# Set to "true" to let a student's own Ollama run the work in their browser.
# Unset, that work is queued for the operator GPU worker instead.
ENABLE_BROWSER_TIER=""

# Set to "true" to read worksheets on the server with a student's own cloud key.
# Unset, every worksheet is queued for the operator GPU worker.
ENABLE_CLOUD_EXTRACTION=""

# Development only
ENABLE_MOCK_AI=""
DISABLE_RATE_LIMITS=""
SKIP_MIGRATIONS=""

# Public launch
CONTACT_EMAIL=""
TRIAL_DAILY_WORKSHEETS=""
SIGNUP_INVITE_CODE=""
ALERT_EMAIL=""
ERROR_WEBHOOK_URL=""
